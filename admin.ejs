<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('partials/header') %>

  <main class="container admin">
    <h1 class="page-title">Admin Panel</h1>

    <section>
      <h2>Add New Anime</h2>
      <form action="/admin/add" method="POST">
        <input type="text" name="title" placeholder="Anime Title" required>
        <textarea name="description" placeholder="Description"></textarea>
        <input type="text" name="genre" placeholder="Genre (comma separated)" required>
        <input type="text" name="image" placeholder="Image URL">
        <button type="submit">Add Anime</button>
      </form>
    </section>

    <section>
      <h2>Add Episode</h2>
      <% if (anime.length === 0) { %>
        <p class="empty-state">Add an anime first.</p>
      <% } else { %>
        <form action="/admin/add-episode" method="POST">
          <select name="animeId" required>
            <% anime.forEach(a => { %>
              <option value="<%= a.id %>"><%= a.title %></option>
            <% }) %>
          </select>
          <input type="number" name="epNumber" placeholder="Episode Number" required>
          <input type="text" name="epTitle" placeholder="Episode Title">
          <input type="text" name="crunchyroll" placeholder="Crunchyroll URL (official)">
          <input type="text" name="otherLink" placeholder="Other official watch URL">
          <button type="submit">Add Episode</button>
        </form>
      <% } %>
    </section>

    <section>
      <h2>Existing Anime</h2>
      <table class="admin-table">
        <thead>
          <tr><th>Title</th><th>Genres</th><th>Episodes</th><th></th></tr>
        </thead>
        <tbody>
          <% anime.forEach(a => { %>
            <tr>
              <td><%= a.title %></td>
              <td><%= a.genre.join(', ') %></td>
              <td><%= a.episodes.length %></td>
              <td>
                <form action="/admin/delete/<%= a.id %>" method="POST" onsubmit="return confirm('Delete this anime?');">
                  <button type="submit" class="delete-btn">Delete</button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </section>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
